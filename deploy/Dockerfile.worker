# Build runtime artifacts from the checked-in source before assembling the
# production image.
# trixie-slim (Debian 13, glibc 2.41) required by duroxide-linux-x64-gnu >= 0.1.25
# (prebuilds link against GLIBC_2.39; bookworm-slim is 2.36 and crashes at dlopen).
FROM node:24.22.1-trixie-slim AS build

# CA certificates for HTTPS. git for agents that work in session workspaces
# (docs/proposals/session-workspaces.md, section 5.4: 2.46 or later; trixie
# ships 2.47). nfs-common gives mount.nfs4 to the workspace attacher, which
# runs from this image as root (packages/sdk/examples/repo-workspaces/attacher.mjs).
# Debian installs mount.nfs setuid root for user mounts; nothing here needs
# that, so the bit goes, and an agent's shell gets no new setuid program.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git nfs-common \
    && rm -rf /var/lib/apt/lists/* \
    && chmod u-s /usr/sbin/mount.nfs

WORKDIR /app

# Copy workspace root and package manifests
COPY package.json package-lock.json ./
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/app/package.json ./packages/app/
# horizon-store package.json must be present BEFORE `npm ci` so npm creates the
# node_modules/@pilotswarm/horizon-store workspace symlink the SDK's dynamic
# import("@pilotswarm/horizon-store") resolves at runtime (optional EnhancedFactStore).
COPY packages/horizon-store/package.json ./packages/horizon-store/
COPY scripts/postinstall.js ./scripts/
# `npm ci` enforces the committed package-lock.json so worker image rebuilds
# from this SHA are byte-reproducible. Matches deploy/Dockerfile.starter.
#
# NPM_REGISTRY lets a build that cannot reach registry.npmjs.org (corporate
# networks routinely block it) install from a mirror instead. Defaults to the
# public registry, so an unset build arg behaves exactly as before. npm's
# replace-registry-host (default `npmjs`) rewrites the lockfile's
# registry.npmjs.org `resolved` URLs onto the configured registry, so the
# lockfile stays authoritative and the image stays reproducible.
ARG NPM_REGISTRY=https://registry.npmjs.org/
ENV npm_config_registry=${NPM_REGISTRY}
RUN npm ci --force

COPY packages/sdk/ ./packages/sdk/
COPY packages/horizon-store/ ./packages/horizon-store/

RUN rm -rf packages/sdk/dist packages/horizon-store/dist \
    && npm run build --workspace=packages/sdk \
    && npm run build --workspace=pilotswarm-horizon-store \
    && npm prune --omit=dev --force

FROM node:24.22.1-trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git nfs-common \
    && rm -rf /var/lib/apt/lists/* \
    && chmod u-s /usr/sbin/mount.nfs

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/app/package.json ./packages/app/
COPY packages/horizon-store/package.json ./packages/horizon-store/
COPY --from=build /app/node_modules/ ./node_modules/

# Copy built SDK dist + bundled plugins, worker script, and app plugins
COPY --from=build /app/packages/sdk/dist/ ./packages/sdk/dist/
COPY packages/sdk/plugins/ ./packages/sdk/plugins/
COPY packages/sdk/examples/worker.js ./packages/sdk/examples/
# The session-workspaces sample: the provider and clone tools
# (PILOTSWARM_EXTENSION_MODULES), the git credential helper, the node attacher,
# and the repo-coder agent (PLUGIN_DIRS). Used only when a deployment turns
# workspaces on; see deploy/providers/azure/gitops/worker/components/workspaces.
COPY packages/sdk/examples/repo-workspaces/ ./packages/sdk/examples/repo-workspaces/
COPY packages/app/tui/plugins/ ./packages/app/tui/plugins/

# api-client (plain ESM) — the SDK's dist/web/api-connection.js imports it at
# load time, so it must be present even though workers use direct { store } mode.
COPY packages/sdk/api/index.js packages/sdk/api/index.d.ts ./packages/sdk/api/
COPY packages/sdk/api/src/ ./packages/sdk/api/src/

# horizon-store built output + runtime-read migrations (the migrator reads the
# numbered migrations/*.sql from disk relative to dist/). Sibling layout matters:
# dist/src/horizon-migrator.js resolves ../../migrations.
COPY --from=build /app/packages/horizon-store/dist/ ./packages/horizon-store/dist/
COPY packages/horizon-store/migrations/ ./packages/horizon-store/migrations/

# AKS legacy-bootstrap catalog. Never copy the private gitignored local catalog
# into a released/deployed image; runtime provider state lives in CMS after the
# one-time compatibility seed.
COPY deploy/config/model_providers.ghcp.json ./.model_providers.json

# The coordination host's extension module, without its tests: the capacity
# requester and admission hook of a Linux worker beside a pool of owner-only
# Windows workers. Nothing loads it unless PILOTSWARM_EXTENSION_MODULES names
# it; see deploy/providers/azure/linux-worker/README.md.
COPY deploy/providers/azure/linux-worker/*.mjs ./deploy/providers/azure/linux-worker/

# Optional: the Copilot CLI program unpacked once, as root, into a folder the
# worker's account can only read. With PILOTSWARM_PERSONAL_SECRETS=external a
# worker starts only with such a copy, named by COPILOT_PKG_CACHE_HOME
# (docs/developer/reference/configuration.md). A build that passes
# COPILOT_PKG_CACHE_HOME, an absolute path in a folder the node user cannot
# write, such as /app/copilot-pkg, runs the program with that setting, as its
# first start would, checks that the copy holds the marker and the files the
# program's loader checks, and leaves the copy owned by root and read-only.
# Set the same COPILOT_PKG_CACHE_HOME on the worker. Without the argument
# nothing is unpacked, and the program unpacks itself into the node user's
# ~/.cache at its first start, as before.
ARG COPILOT_PKG_CACHE_HOME
RUN set -eu; if [ -n "${COPILOT_PKG_CACHE_HOME:-}" ]; then \
        case "$COPILOT_PKG_CACHE_HOME" in /*) ;; *) echo "COPILOT_PKG_CACHE_HOME must be an absolute path" >&2; exit 1 ;; esac; \
        platform="linux-$(node -p process.arch)"; \
        program="$(node -p 'require("node:module").createRequire(require.resolve("@github/copilot/package.json")).resolve(`@github/copilot-${process.argv[1]}`)' "$platform")"; \
        version="$(node -p 'require(process.argv[1]).version' "$(dirname "$program")/package.json")"; \
        COPILOT_PKG_CACHE_HOME="$COPILOT_PKG_CACHE_HOME" "$program" --no-auto-update --version; \
        copy="$COPILOT_PKG_CACHE_HOME/pkg/$platform/$version"; \
        for file in .extraction-complete index.js app.js "prebuilds/$platform/runtime.node"; do \
            test -f "$copy/$file" || { echo "the Copilot CLI program's copy has no $copy/$file" >&2; exit 1; }; \
        done; \
        chown -R root:root "$COPILOT_PKG_CACHE_HOME"; \
        chmod -R a+rX,a-w "$COPILOT_PKG_CACHE_HOME"; \
    fi

# Run as the built-in node user (non-root)
USER node

ENTRYPOINT ["node", "packages/sdk/examples/worker.js"]
