# Template for OSS Node deploy orchestrator local env files.
#
# This file is the source the scaffolder (deploy/scripts/new-env.mjs) copies
# from when creating a personal env at deploy/envs/local/<name>/env. Local
# files are STANDALONE — there is no runtime cascade onto this template.
# That means edits to this template only affect newly-scaffolded envs, not
# existing ones (an existing local env is a complete frozen record of its
# original deployment target).
#
# What lives here:
#   • Generic static defaults safe for any stamp (region, namespace, WAF
#     mode, ACR SKU, edge mode, TLS source, MS tenant, etc.)
#   • Empty placeholders for deployment-target keys — the scaffolder
#     substitutes per-stamp values during `npm run deploy:new-env`.
#
# What does NOT live here (computed by Bicep / cascaded at runtime via the
# FR-022 alias map): ACR/AKS/KV names, storage endpoints, workload-identity
# clientId, approver UAMI id, Front Door identifiers, etc. Resource *names*
# are derived inside Bicep from RESOURCE_PREFIX (e.g. `${alphaPrefix}sa${unique6}`,
# `${prefix}-aks`); we do not pre-compute them here.

# ─── Subscription & deployment targets (scaffolder fills these in) ───
DEPLOY_PROVIDER=azure
SUBSCRIPTION_ID=
LOCATION=westus3

# RESOURCE_PREFIX is the Bicep `resourceNamePrefix` input — uniquely names
# every Azure resource in BaseInfra/Worker/Portal templates. Scaffolder
# pattern: ps<envname>.
RESOURCE_PREFIX=

# Per-region RG that BaseInfra/Worker/Portal deploy into.
# Scaffolder pattern: ${RESOURCE_PREFIX}-${regionShort}-rg.
RESOURCE_GROUP=

# GlobalInfra deployment target (subscription-scope deployment lands an RG of
# this name and provisions Front Door + DNS into it).
# Scaffolder pattern: ${RESOURCE_PREFIX}global.
GLOBAL_RESOURCE_PREFIX=
GLOBAL_RESOURCE_GROUP=

# Portal logical resource name (Portal Bicep `resourceName` param).
# Scaffolder pattern: ${RESOURCE_PREFIX}-${regionShort}-portal.
PORTAL_RESOURCE_NAME=

# Worker pod namespace inside the AKS cluster.
NAMESPACE=pilotswarm

# Optional package registry URL for application image builds. Leave empty to
# use the public registry configured by each Dockerfile.
NPM_REGISTRY=

# ─── Bicep input parameters (static) ───
# SSL_CERT_DOMAIN_SUFFIX is only consumed by the enterprise path
# (cert subject = `${resourceName}.${SSL_CERT_DOMAIN_SUFFIX}`); OSS deploys
# leave it empty and bicep derives the cert subject from the AppGw's Azure
# DNS label instead. See deploy/scripts/lib/overlay-contracts.mjs for the
# per-overlay roster: SSL_CERT_DOMAIN_SUFFIX is userRequired on afd-akv
# and stubbed (to `unused`) on the other overlays. AFD_ENDPOINT_HOSTNAME
# and AFD_ROUTE_NAME are intentionally absent from this template — they
# are bicep outputs (or composed) and are not user-supplied inputs.
SSL_CERT_DOMAIN_SUFFIX=
WAF_MODE=Prevention
ACR_SKU=Basic
APP_GATEWAY_PRIVATE_IP=10.20.16.10

# ─── Observability ───
# Log Analytics workspace retention (days) for AKS Container Insights
# (ContainerLogV2). 30 is included free; longer is billed at the
# workspace's PerGB2018 rate.
LOG_ANALYTICS_RETENTION_DAYS=30

# Optional path (relative to repo root or absolute) to a JSON file containing
# an array of AFD WAF custom rules merged into properties.customRules.rules at
# deploy time. Recommended location: `deploy/envs/local/<env>/waf-custom-rules.json`
# (the entire `deploy/envs/local/` tree is gitignored, so site-specific rules
# such as corpnet allow-lists never get checked in). Leave unset to deploy
# with no custom rules. Example contents:
#   [
#     { "name": "AllowServiceTagRule", "enabledState": "Enabled", "priority": 100,
#       "ruleType": "MatchRule", "action": "Block",
#       "matchConditions": [{
#         "matchVariable": "SocketAddr", "operator": "ServiceTagMatch",
#         "negateCondition": true, "matchValue": ["CorpNetPublic", "CorpNetSAW"]
#       }] }
#   ]
WAF_CUSTOM_RULES_FILE=

# Optional path (relative to repo root or absolute) to a JSON file containing
# an array of AppGw WAF custom rules merged into the AppGw WAF policy's
# `customRules.rules` array at deploy time. Recommended location:
# `deploy/envs/local/<env>/appgw-waf-custom-rules.json` (gitignored). When
# VPN_GATEWAY_ENABLED=true the bicep auto-seeds three guard rules at
# priorities 90/91/92 (AllowAfd / AllowVpn / BlockOther) — operator rules
# loaded from this file MUST start at priority >= 100. Leave unset to deploy
# with no operator-supplied AppGw rules. Mirrors the AFD-side
# WAF_CUSTOM_RULES_FILE machinery above.
APPGW_WAF_CUSTOM_RULES_FILE=

# ─── Edge / public-ingress topology ───
# Edge modes:
#   afd     — Azure Front Door + Private Link → AppGw private listener.
#             AFD endpoint at `*.z01.azurefd.net` is the user-facing URL.
#             Requires a publicly-trusted cert (Azure rejects self-signed
#             PL origins with `EnforceCertificateNameCheck must be enabled
#             for Private Link`). For OSS, the cert subject is the AppGw's
#             `<name>.<region>.cloudapp.azure.com` Azure DNS label and LE
#             issues via cert-manager (TLS_SOURCE=letsencrypt) — zero DNS
#             prerequisite. For enterprise the subject is
#             `${resourceName}.${SSL_CERT_DOMAIN_SUFFIX}` and the cert
#             comes from an AKV-registered issuer (TLS_SOURCE=akv).
#   private — AKS managed NGINX on an internal LoadBalancer, with a private
#             DNS zone and a dedicated VNet. Uses an AKV certificate.
#   public  — AKS managed NGINX on a public LoadBalancer with an Azure DNS
#             label and Let's Encrypt. AKS manages its network; this
#             provider creates no dedicated VNet, AppGw, or Front Door.
#             Entra portal auth and database managed identity are required.
EDGE_MODE=afd

# ─── TLS cert source ───
# Two sources:
#   letsencrypt — cert-manager + Let's Encrypt prod (HTTP-01 for afd or
#                 public). Default for OSS / testing.
#                 Auto-renewing. Requires ACME_EMAIL.
#   akv         — AKV-registered issuer + bicep cert deployment script
#                 (BYO CA). Required for the enterprise path and any closed-network
#                 deployment. Requires PORTAL_TLS_ISSUER_NAME pointing at
#                 a registered issuer (see akv-certificate-issuer.bicep).
# Self-signed is no longer supported on the deploy path. For local
# off-Azure development the in-process portal still uses self-signed.
TLS_SOURCE=letsencrypt

# ACME registration email (Let's Encrypt). LE sends renewal-failure
# notices here. Required when TLS_SOURCE=letsencrypt; ignored for akv.
# Per-stamp value — scaffolder prompts for this so the template doesn't
# leak personal addresses.
ACME_EMAIL=

# ─── Overlay .env-only static keys ───
# Consumed by deploy/providers/azure/gitops/<service>/overlays/<env>/.env via substitute-env.mjs.
# AZURE_TENANT_ID is the Entra tenant for the target subscription.
AZURE_TENANT_ID=

# ─── Portal ownership / visibility security posture ───
# false = audit-only dark launch; true = enforce owner/share boundaries.
AUTHZ_ENFORCE_OWNERSHIP=false
# Apply identically to portals and workers; cluster requires authenticated access.
AUTHZ_ADMIN_SCOPE=unrestricted
# Applies only to sessions created after this setting is deployed.
SESSIONS_DEFAULT_VISIBILITY=private
# read = users may inspect system sessions; admin = hidden from users.
SESSIONS_SYSTEM_VISIBILITY=read
# DISPATCHER_SP_OBJECT_ID is optional and unset by default, which turns
# dispatcher delegation off: the object ID of an application that users may let
# create sessions for them and end the sessions it created. new-env prompts for
# it with the other portal config keys.
#
# Optional portal settings. Each default is the portal's behavior without the
# setting, and a setting at its default stays out of the portal's manifests:
#   PILOTSWARM_REQUIRE_FINE_GRAINED_GH_PAT=1     accept only fine-grained GitHub
#                                                tokens for GitHub providers
#   PILOTSWARM_PERSONAL_SECRETS=external         keep personal tokens only in the
#                                                store module below (default
#                                                database)
#   PILOTSWARM_PERSONAL_SECRET_STORE_MODULE=<path in the portal image>, for
#     example /app/deploy/providers/azure/secret-store/keyvault-personal-secret-store.mjs
#   PILOTSWARM_PERSONAL_SECRET_VAULT_URI=https://<vault>.vault.azure.net/
#                                                the Key Vault store's vault;
#                                                with WIN_WORKERS_ENABLED=true it
#                                                defaults to the stamp's
#                                                personal vault
#   PILOTSWARM_OWNER_ROUTING=1                   record owner tags on user
#                                                sessions; needs
#                                                WIN_WORKERS_ENABLED=true
#   PILOTSWARM_WORKSPACE_BUSY_FAST_RELEASE=1     the fast busy policy for new
#                                                sessions and their children
#   PILOTSWARM_DEFAULT_IDLE_TIMEOUT_SEC=600      idle hold before dehydration
#                                                (default 1800 seconds)
#   PILOTSWARM_SESSION_MESSAGE_SCOPE=owner       keep facts and session messages
#                                                within one owner (default fleet)

# Kubernetes IngressClass that AGIC publishes on the stamp. Consumed by the
# cert-manager-issuers Let's Encrypt ClusterIssuer (HTTP-01 solver) and any
# Ingress object that needs to opt into AGIC. AGIC's default class is
# `azure-application-gateway`; override only if a stamp explicitly configures
# a non-default class on the AGIC controller.
INGRESS_CLASS=azure-application-gateway

# PORTAL_HOSTNAME is intentionally NOT set here. It is a per-stamp value
# derived from the bicep `${resourceName}.${sslCertificateDomainSuffix}`
# formula and surfaced as the Portal bicep `backendHostName` output. The
# `OUTPUT_ALIAS` map in `deploy/scripts/lib/deploy-bicep.mjs` aliases that
# output to `PORTAL_HOSTNAME`, which is then substituted into the Portal
# overlay `.env` (placeholder `__PORTAL_HOSTNAME__`). For workflows that
# run `--steps manifests,rollout` without `bicep`, the value comes from
# the bicep-outputs cache (`deploy/.tmp/<env>/bicep-outputs.cache.json`)
# populated by a prior bicep step. If the cache is empty, run with
# `--steps bicep,manifests,rollout` once so the cache fills.

# ─── Database provisioning ───
# true = base-infra provisions the stamp PostgreSQL flexible server (default).
# false = use an existing PostgreSQL-compatible database, including HorizonDB.
# Legacy 1/0 values are normalized to JSON booleans. Older env files without
# this key retain the provisioned default; there is no template cascade.
# Disabling provisioning does NOT delete a previously provisioned server.
DEPLOY_POSTGRES=true

# One optional HorizonDB cluster for runtime/CMS, enhanced facts and AGE graph.
# On public AKS this reserves a stable outbound IP and allows only that IP in
# the HorizonDB public firewall. The password and connection URL live in KV.
# Requires DEPLOY_POSTGRES=false, PILOTSWARM_USE_MANAGED_IDENTITY=0,
# FOUNDRY_ENABLED=true, and both URL secret references set to horizondb-url.
HORIZONDB_ENABLED=false
HORIZONDB_CLUSTER_NAME=
HORIZONDB_ADMIN_LOGIN=pilotswarm
HORIZONDB_ADMIN_PASSWORD_SECRET_NAME=horizondb-admin-password
HORIZONDB_URL_SECRET_NAME=horizondb-url
HORIZONDB_DATABASE_NAME=postgres
HORIZONDB_VCORES=4
# Nodes in the pool (1-16). One node has no high availability.
HORIZONDB_NODE_COUNT=1
HORIZON_EMBED_MODEL=text-embedding-3-small
HORIZON_EMBED_DIM=1536
HORIZON_EMBED_API_KEY_HEADER=api-key

# Session workspaces, the reference deployment
# (docs/proposals/session-workspaces.md, section 12.1). true = deploy the
# repo-cache service (a repo pod that mirrors github.com/microsoft/duroxide
# and exports it, with a folder all sessions share, over NFS), add the
# `repocache` node pool (one always-on node for that pod, ~ one more
# Standard_D4ds_v5 VM), and add the workspaces component to the worker and
# portal (the node attacher, the /ws mount, the sample provider, clone tools
# and repo-coder agent). The nodes need the kernel NFS server module (nfsd);
# Azure Linux has it. Older env files without this key keep it off. Turning
# it off later does not delete the node pool or the repo pod (see the
# README in packages/sdk/examples/repo-workspaces).
WORKSPACES_ENABLED=false

# Autoscaler minimum of the user node pool (1 to 10). Session workspaces'
# cross-node tests need 2.
#
# In GitHub Actions, WORKSPACES_ENABLED and USER_POOL_MIN_COUNT can also come
# from variables of the deploy environment (vars.*); a set variable wins over
# the line here (see .github/workflows/deploy-azure.yml).
USER_POOL_MIN_COUNT=1

# BYO connections: supply both URLs here (gitignored) and run seed-secrets.
# They are stored in the stamp Key Vault and projected through CSI Secrets,
# NEVER through the BYO ConfigMap. Alternatively, supply both *_SECRET_NAME
# values for secrets already in that vault; seed-secrets leaves those alone.
# Default secret names for supplied URLs are database-url and
# pilotswarm-cms-facts-database-url. Manifests pin the resolved KV versions.
# Raw URLs must match those KV versions; changed values require seed-secrets.
# Shell URL overrides apply only to BYO, never to provisioned stamps.
# Use a separate database/role per test environment on a shared cluster.
DATABASE_URL=
PILOTSWARM_CMS_FACTS_DATABASE_URL=
DATABASE_URL_SECRET_NAME=
PILOTSWARM_CMS_FACTS_DATABASE_URL_SECRET_NAME=
# Required for BYO Entra auth; omitted from BYO password-authenticated overlays.
PILOTSWARM_DB_AAD_USER=

# ─── Bicep-deploy database and Blob auth ───
# Database: 1 = Entra; 0 = credentials in the supplied URLs. Entra uses
# an AAD token callback for CMS+facts pools and routes
# the duroxide orchestration store through duroxide-node's native Entra
# path (PostgresProvider.connectWithSchemaAndEntra, duroxide-node ≥
# 0.1.25). Legacy `scripts/deploy-aks.sh` does NOT consume these — its
# own K8s secret keeps the connection-string flow intact.
PILOTSWARM_USE_MANAGED_IDENTITY=1
# Independent Blob auth, including when database auth is password-based.
# Keep enabled on this deploy path; no Blob connection-string secret is seeded.
PILOTSWARM_BLOB_USE_MANAGED_IDENTITY=1
AZURE_STORAGE_CONTAINER=copilot-sessions
PILOTSWARM_TURN_TIMEOUT_MS=2700000
# Opt in to coalesced in-progress assistant text/reasoning in the portal.
PILOTSWARM_LIVE_TURN=0
# Native Copilot tasks are always on: workers offer them, so sessions can hand
# local work to native sub-agents, including agents adopted from a session
# workspace's repo. sync is the only effective value; an older "off" is
# deployed as sync. A GitHub variable of the deploy environment with this name
# wins over this line.
PILOTSWARM_NATIVE_SUBAGENTS=sync

# ─── Azure AI Foundry (optional) ───
# When true, base-infra provisions a Microsoft.CognitiveServices/accounts
# (kind=AIServices) named `${RESOURCE_PREFIX}-aif` and the operator-supplied
# JSON file at FOUNDRY_DEPLOYMENTS_FILE drives N model deployments under it.
# Account-key auth is the compatibility default. Set FOUNDRY_AUTH_MODE=entra
# to disable local auth and use the worker workload identity. The account's
# data-plane endpoint flows into the worker base catalog as
# `__FOUNDRY_ENDPOINT__` substitution at manifest-staging time. When false,
# no Foundry account is provisioned and the catalog Foundry providers stay
# unresolved at runtime.
FOUNDRY_ENABLED=false

# Foundry SKU. S0 is the only generally-available paid SKU for AIServices.
FOUNDRY_SKU=S0

# Data-plane authentication mode: key (default) or entra.
FOUNDRY_AUTH_MODE=key

# Optional account-region override. Leave empty to co-locate Foundry with the
# stamp; set this when the stamp region lacks the required model deployments.
FOUNDRY_LOCATION=

# Path (relative to repo root or absolute) to a JSON array file describing
# the model deployments to create under the Foundry account. Threaded into
# the bicep deploy as `--parameters foundryDeployments=@<file>`. The
# scaffolder writes deploy/envs/local/<env>/foundry-deployments.json when
# FOUNDRY_ENABLED is selected during `npm run deploy:new-env`. The entire
# `deploy/envs/local/` tree is gitignored, so the file is per-stamp and
# never checked in. Required when FOUNDRY_ENABLED=true; ignored otherwise.
FOUNDRY_DEPLOYMENTS_FILE=

# Optional per-stamp model catalog (metadata and env: credential references
# only). Worker and portal stage the same file. Leave blank for the shared
# provider catalog; use an ignored local file for Foundry-only stamps.
MODEL_PROVIDERS_FILE=

# ─── Optional: VPN Gateway P2S (hybrid AFD + VPN) ───
# Adds an Azure VPN Gateway (Point-to-Site, Microsoft Entra ID auth, OpenVPN
# protocol) as an additive, optional ingress path that coexists with the AFD
# edge mode. The trusted-bypass pattern for authenticated tenant users who
# hold a valid Entra ID token but are blocked at the public edge by
# operator-defined AFD WAF allow-lists (typically service-tag, IP-range, or
# header-based rules that gate the public ingress to a known managed-network
# population).
#
# Hard requirements (enforced by deploy/scripts/lib/overlay-contracts.mjs
# validateVpnGatewayCombo()):
#   * EDGE_MODE=afd       — the auto-seeded AppGw WAF guard rules at
#                           priorities 90/91/92 only make sense when AFD is
#                           the public ingress and AppGw is private-FE.
#   * TLS_SOURCE=akv      — Let's Encrypt is unsupported on the VPN path
#                           (HTTP-01 cannot reach a VPN-only client).
#   * SSL_CERT_DOMAIN_SUFFIX must be set (managed Private DNS zone uses it).
#   * VPN_CLIENT_ADDRESS_POOL must NOT overlap the VNet (default 10.20.0.0/16).
#
# Cost: ~$450/mo for VpnGw2AZ + Azure Private DNS Resolver inbound endpoint
# (~$280 VPN + ~$170 resolver). The Resolver is co-provisioned unconditionally
# when VPN_GATEWAY_ENABLED=true because P2S clients cannot reach 168.63.129.16
# through the tunnel — without the Resolver inbound endpoint advertised via
# the VNet's dhcpOptions.dnsServers (the supported P2S DNS-push path), clients
# cannot resolve the portal Private DNS Zone hostname over the VPN.
# First-deploy time: 45+ min (gateway provisioning is the long pole).
# Subsequent param changes are faster but VPN gateway updates are still
# measured in minutes.
#
# Tenant: VPN runs in the same Entra ID tenant as the rest of the stamp
# (uses existing AZURE_TENANT_ID — threaded into base-infra bicep as the
# `tenantId` param and consumed by the VPN gateway module's AAD config).
#
# Required Conditional Access policy (tenant admin): the Azure VPN Client
# app `c632b3df-fb67-4d84-bdcf-b95ad541b5c8` must be permitted for the user
# groups you want to allow over the VPN. The legacy audience
# `41b23e61-6c1e-4545-b367-cd054e0ed4b4` is supported as an override only
# for stamps that have to interop with older Azure VPN client builds — see
# the `pilotswarm-new-env-deploy` skill for the documented override flow.
VPN_GATEWAY_ENABLED=false
VPN_GATEWAY_SKU=VpnGw2AZ                                  # @allowed: VpnGw2AZ / VpnGw3AZ / VpnGw4AZ / VpnGw5AZ. Generation2 AZ SKUs only. VpnGw1AZ (Generation1) is excluded — silently drops OpenVPN+AAD HardResetClientV2 packets ~5s after TCP accept. Non-AZ SKUs (VpnGw1/2/3) and Basic are also rejected.
VPN_CLIENT_ADDRESS_POOL=172.16.200.0/24                   # MUST NOT overlap the VNet (default 10.20.0.0/16). /24 gives ~250 concurrent clients.
VPN_AAD_AUDIENCE=c632b3df-fb67-4d84-bdcf-b95ad541b5c8     # Microsoft-registered Azure VPN Client app ID. Legacy 41b23e61-6c1e-4545-b367-cd054e0ed4b4 supported as documented override.

# ─── Optional: policy-restricted subscriptions ───
# AZURE_POLICY_RESTRICTED=true deploys a stamp that a subscription accepts when its Azure
# Policy requires a network security perimeter, denies Storage shared keys and
# denies ARM deployment scripts: a perimeter around the stamp Key Vault and
# storage account, a blob private endpoint, explicit subnet NSGs, the pinned
# cluster egress IP, Entra-only PostgreSQL behind an egress-only firewall, and
# Azure CLI deploy steps in place of deployment scripts. Requires EDGE_MODE=afd
# and TLS_SOURCE=letsencrypt. Unset means false: the stamp deploys as before.
# See "Policy-restricted subscriptions" in docs/developer/deploy/aks.md.
# AZURE_POLICY_RESTRICTED=false
#
# With AZURE_POLICY_RESTRICTED=true: comma-separated public IPv4 addresses or CIDR
# prefixes that the perimeter also admits, for an operator who seeds secrets or
# publishes manifests from outside the stamp. Add only an address the perimeter
# actually sees as the source. Unset by default.
# PERIMETER_OPERATOR_IP_PREFIXES=203.0.113.0/24

# ─── Optional: Windows worker pool ───
# WIN_WORKERS_ENABLED=true deploys a pool of Windows worker VMs beside the
# cluster: an Azure Compute Gallery image definition, a Flexible scale set with
# a standby pool of deallocated VMs, the disk controller that leases a Dev Drive
# to each work and brokers its credentials, a personal Key Vault for owners'
# tokens, a deploy-only Key Vault, the controller's own storage account, a
# worker subnet with a NAT gateway and an NSG that isolates every VM, private
# endpoints, Entra-only PostgreSQL that admits only the stamp's egress
# addresses, and security alerts. Requires EDGE_MODE=afd or private, the
# stamp's own PostgreSQL server with PILOTSWARM_USE_MANAGED_IDENTITY=1, the
# portal's Entra app (PORTAL_AUTH_ENTRA_CLIENT_ID, set up with
# deploy/scripts/auth/Setup-PortalAuth.ps1 -WorkerRoles) and at least one
# alert receiver. The subscription owner creates three custom role
# definitions first; the deploy step prints them when one is missing. The
# first deploy creates no VM: build the image into the gallery, set
# WIN_WORKER_IMAGE_VERSION and deploy again. Unset means false: the stamp
# deploys as before.
WIN_WORKERS_ENABLED=false
# Comma-separated email addresses that receive the pool's alerts. Required with
# WIN_WORKERS_ENABLED=true.
WIN_WORKER_ALERT_EMAILS=
#
# The pool's other settings, at their defaults:
# Most active VMs (X): the scale set's ceiling and the standby pool's size.
# WIN_WORKER_COUNT=5
# Fewest active VMs (Y), and the scale set's capacity when it is created. 0
# needs WIN_WORKER_COORDINATION_HOST=true.
# WIN_WORKER_MIN_RUNNING=1
# Deallocated VMs the standby pool keeps ready.
# WIN_WORKER_STANDBY_MIN=1
# The VMs' size; it needs nested virtualization. A change applies to new VMs,
# and the controller replaces the old ones.
# WIN_WORKER_VM_SIZE=Standard_D16ds_v5
# The gallery image version (Major.Minor.Patch). No scale set until it is set.
# WIN_WORKER_IMAGE_VERSION=1.0.0
# Idle minutes before a bound VM, or the ready one, is drained and deleted.
# WIN_WORKER_IDLE_RECYCLE_MINUTES=30
# Most idle VMs deleted in one scale-in step, and the minutes between steps.
# WIN_WORKER_SCALE_IN_BATCH=1
# WIN_WORKER_SCALE_IN_INTERVAL_MINUTES=5
# true: the Linux worker becomes the coordination host and the Windows workers
# run only their owner's work. Needs PILOTSWARM_OWNER_ROUTING=1 and
# WORKSPACES_ENABLED=false; its identity needs the portal app's coordinator
# role (see "Optional: Windows worker pool" in deploy/scripts/README.md).
# WIN_WORKER_COORDINATION_HOST=false
# With the coordination host: its replicas (0 to 20; an upgrade freeze
# publishes 0), a ConfigMap in the worker's namespace holding the plugin.json,
# session-policy.json and *.agent.md files of the plugin whose session policy
# and agents the Windows workers load, and comma-separated token prefixes it
# redacts from what it persists. No plugin and no prefix by default.
# WIN_WORKER_COORDINATION_HOST_REPLICAS=2
# WIN_WORKER_COORDINATION_HOST_PLUGIN_CONFIGMAP=
# WIN_WORKER_COORDINATION_HOST_REDACT_SECRET_PREFIXES=
# Hours in which at least one VM stays active, such as
# Mon-Fri 08:00-18:00 America/Los_Angeles. Unset by default.
# WIN_WORKER_WORKING_HOURS=
# Non-secret NAME=VALUE pairs for every Windows worker, separated by
# semicolons (so a value can't hold one; at most 4096 characters each). Names
# that start with NODE_, COPILOT_, PILOTSWARM_, PS_, WIN_WORKER_, AZURE_, GIT_,
# NUGET_, GCM_ or ARTIFACTS_CREDENTIALPROVIDER_, and PATH, TEMP, DATABASE_URL,
# GITHUB_TOKEN and the other names the workers' settings already use, are
# refused, compared without case. Any process on a VM can read these values.
# WIN_WORKER_EXTRA_ENV=EXAMPLE_API_URL=https://api.example.com;EXAMPLE_MODE=on
# Comma-separated https package feed URLs that the workers' NuGet credential
# provider signs in to with the workers' managed identity. Unset by default.
# WIN_WORKER_FEED_ENDPOINTS=
# The object ID of the Standby Pool Resource Provider's service principal in
# the tenant. The deploy step looks it up when unset, which needs directory
# read access.
# WIN_WORKER_STANDBY_POOL_PRINCIPAL_ID=
#
# Dev Drives: most drives at once (M), hydrated spares, most per owner (N),
# days before an unused, unparked lease is returned, a new drive's size, online
# growth (grow by a step when less free space than the share is left, up to
# the maximum) and provisioned IOPS.
# WIN_DEV_DRIVE_POOL_COUNT=10
# WIN_DEV_DRIVE_SPARE_COUNT=2
# WIN_DEV_DRIVE_MAX_PER_USER=3
# WIN_DEV_DRIVE_LEASE_EXPIRY_DAYS=7
# WIN_DEV_DRIVE_SIZE_GB=1024
# WIN_DEV_DRIVE_GROW_FREE_PERCENT=20
# WIN_DEV_DRIVE_GROW_STEP_GB=256
# WIN_DEV_DRIVE_MAX_GB=2048
# WIN_DEV_DRIVE_IOPS=6000
# The controller's other settings (deploy/providers/azure/disk-controller/README.md):
# WIN_DEV_DRIVE_MBPS=250
# WIN_DEV_DRIVE_GOLDEN_SNAPSHOT_ID=
# PS_DISK_CONTROLLER_STARTUP_GRACE_SECONDS=60
# PS_DISK_CONTROLLER_SNAPSHOT_REFRESH_DAYS=7
# Unset: C:\pilotswarm\scripts, where the image installs the VM scripts.
# PS_DISK_CONTROLLER_VM_SCRIPTS_DIR=
# With EDGE_MODE=afd, the prefix of the App Gateway trusted roots that the
# deploy uploads for the controller's CAs. A CA already on a root keeps that
# root, whatever its name (a stamp from before CA rotations keeps the root of
# this very name); a CA on none is uploaded as <prefix>-<first 12 hex of its
# SHA-256>. The dispatcher Ingress lists the roots (two during a CA rotation).
# One name, not a list.
# APPGW_TRUSTED_ROOT_CERTS=pilotswarm-disk-controller-ca
