{
  "schemaVersion": 1,
  "notes": "Example seed: two public repositories, the npm cache and a scratch folder that every drive gets empty.",
  "reposRoot": "Q:\\Repos",
  "repositories": [
    {
      "name": "PilotSwarm",
      "url": "https://github.com/microsoft/PilotSwarm.git",
      "branch": "main",
      "submodules": true,
      "lfs": false
    },
    {
      "name": "Hello-World",
      "url": "https://github.com/octocat/Hello-World.git",
      "branch": "master",
      "submodules": false,
      "lfs": false
    }
  ],
  "modifyFolders": [
    "Q:\\Repos\\PilotSwarm",
    "Q:\\Repos\\Hello-World"
  ],
  "folders": [
    {
      "path": "Q:\\.cache\\npm",
      "access": "modify",
      "notes": "npm_config_cache in the example worker settings"
    },
    {
      "path": "Q:\\temp",
      "access": "modify",
      "notes": "scratch space for builds"
    }
  ],
  "packageCaches": [
    {
      "name": "npm",
      "workingDirectory": "Q:\\Repos\\PilotSwarm",
      "command": ["npm.cmd", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
      "env": {
        "npm_config_cache": "Q:\\.cache\\npm"
      }
    }
  ],
  "beforeSnapshot": [
    {
      "emptyFolder": "Q:\\temp",
      "reason": "scratch files of the seed's own commands; every drive starts with an empty scratch folder"
    }
  ]
}
