# An example worker settings file (Build-WorkerOsImage.ps1 -WorkerSettingsFile).
# NAME=VALUE lines, values taken literally. Install-WinWorkerService.ps1 writes
# them into C:\pilotswarm\worker.env after the image's own values and its
# defaults; README, "The worker settings file", lists what a settings file may
# and may not set. No secrets: every process on the VM can read worker.env.

# Git: the identity of the worker's commits, and where the Dev Drive extension
# pushes a drive's work in progress (<prefix><root session ID> on origin).
GIT_AUTHOR_NAME=PilotSwarm Agent
GIT_COMMITTER_NAME=PilotSwarm Agent
GIT_AUTHOR_EMAIL=pilotswarm-agent@example.com
GIT_COMMITTER_EMAIL=pilotswarm-agent@example.com
PS_WIP_BRANCH_PREFIX=pilotswarm/wip/

# Capacity of one VM.
PILOTSWARM_WORKER_CONCURRENCY=4
PILOTSWARM_ORCHESTRATION_CONCURRENCY=4
PILOTSWARM_TURN_TIMEOUT_MS=5400000

# The npm cache that the example seed manifest fills on the Dev Drive.
npm_config_cache=Q:\.cache\npm

# What agents' shells and MCP servers see besides the platform's own
# variables (the image always sets PILOTSWARM_SCRUB_CLI_ENV=1).
PILOTSWARM_CLI_ENV_ALLOWLIST=GIT_*,GCM_*,npm_config_*,MSBUILD*,AZURE_CONFIG_DIR,AZURE_EXTENSION_*

# The deployment's plugin and headless instructions, which the attacher's
# release sync installs from current-release.json.
PLUGIN_DIRS=C:\pilotswarm\plugins\example-plugin
COPILOT_CUSTOM_INSTRUCTIONS_DIRS=C:\pilotswarm\headless-instructions

# Persisted events, tool output and logs never keep strings with these prefixes.
PILOTSWARM_REDACT_SECRET_PREFIXES=example_
