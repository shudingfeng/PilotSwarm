# Overlay values rewritten by the deploy pipeline (substitute-env.mjs) from the
# env map at rollout time, once a deploy step publishes the disk controller.
# Keys MUST appear here for the substituter to target them; placeholder values
# are overwritten. `__PS_UNSET__` leaves a setting unset.
#
# Read by the kustomize replacements:
IMAGE=placeholder.azurecr.io/pilotswarm-disk-controller:placeholder
NAMESPACE=pilotswarm
KV_NAME=placeholder
WORKLOAD_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
PORTAL_HOSTNAME=placeholder.example.com
#
# Read by the controller (deploy/providers/azure/disk-controller/README.md):
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
PS_DISK_POOL_STATE_URL=https://placeholder.blob.core.windows.net/disk-pool-state
PS_DISK_CONTROLLER_TOKEN_SCOPE=api://00000000-0000-0000-0000-000000000000/.default
EXPECTED_WIN_WORKER_OID=00000000-0000-0000-0000-000000000000
DISPATCHER_SP_OBJECT_ID=__PS_UNSET__
PILOTSWARM_PERSONAL_SECRET_VAULT_URI=__PS_UNSET__
WIN_WORKER_SCALE_SET_ID=__PS_UNSET__
WIN_WORKER_DCR_ID=__PS_UNSET__
WIN_WORKER_STANDBY_POOL_ID=__PS_UNSET__
WIN_WORKER_GALLERY_IMAGE_ID=__PS_UNSET__
WIN_WORKER_IMAGE_VERSION=__PS_UNSET__
WIN_WORKER_CONFIG_VERSION=__PS_UNSET__
WIN_WORKER_COORDINATION_HOST=false
WIN_WORKER_COUNT=5
WIN_WORKER_MIN_RUNNING=1
WIN_WORKER_IDLE_RECYCLE_MINUTES=30
WIN_WORKER_SCALE_IN_BATCH=1
WIN_WORKER_SCALE_IN_INTERVAL_MINUTES=5
WIN_WORKER_WORKING_HOURS=__PS_UNSET__
WIN_DEV_DRIVE_GOLDEN_SNAPSHOT_ID=__PS_UNSET__
WIN_DEV_DRIVE_POOL_COUNT=10
WIN_DEV_DRIVE_SPARE_COUNT=2
WIN_DEV_DRIVE_MAX_PER_USER=3
WIN_DEV_DRIVE_LEASE_EXPIRY_DAYS=7
WIN_DEV_DRIVE_SIZE_GB=1024
WIN_DEV_DRIVE_GROW_FREE_PERCENT=20
WIN_DEV_DRIVE_GROW_STEP_GB=256
WIN_DEV_DRIVE_MAX_GB=2048
WIN_DEV_DRIVE_IOPS=6000
WIN_DEV_DRIVE_MBPS=250
PS_DISK_CONTROLLER_STARTUP_GRACE_SECONDS=60
PS_DISK_CONTROLLER_SNAPSHOT_REFRESH_DAYS=7
PS_DISK_CONTROLLER_VM_SCRIPTS_DIR=__PS_UNSET__
